---
import { render } from "astro:content";
import Page from "../layouts/Page.astro";
import { getPosts, formatDate } from "../data/content";

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Page title={post.data.title} description={post.data.description} meta={formatDate(post.data.date)} type="article">
  <meta slot="head" property="article:published_time" content={post.data.date.toISOString()} />
  <Content />
  <p class="back"><a class="btn is-quiet is-small" href="/">All posts</a></p>
</Page>
